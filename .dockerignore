.git
.gitignore
.claude/
.claude.json
.claude.json.backup.*
.kube/
.local/
.bash_history
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.env
.env.*
# Patterns without a leading **/ only match at the context root; the combined
# image builds from the repo root so per-subdir junk must be excluded too.
**/.venv/
**/node_modules/
**/__pycache__/
**/dist/
**/.env
**/.env.*
!**/.env.example
*.log
.DS_Store
.idea/
.vscode/
*.swp
dist/
build/
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
tmp/
temp/
*.kubeconfig
kubeconfigs/
