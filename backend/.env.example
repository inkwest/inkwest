# Backend env for local dev — copy to backend/.env (gitignored):
#   cp backend/.env.example backend/.env
#
# docker-compose.yml already injects the bulk of the backend config (DATABASE_URL,
# AI_PROVIDER, OIDC, connectors, …) and the sandbox INFRA wiring that's coupled to the
# dind sidecar (DOCKER_HOST + TLS, SANDBOX_SQUID_CONF, SANDBOX_SQUID_ERRORS,
# SANDBOX_SESSIONS_ROOT, SANDBOX_ENV_FILE). This file only carries the per-conversation sandbox knobs
# the compose file leaves to you. (Running the backend on the host instead of compose?
# Then also set DATABASE_URL and any provider keys here.)

# =============================================================================
# PER-CONVERSATION DOCKER SANDBOX  (claude-cli provider only)
# =============================================================================
# When on, each conversation runs `claude` in its own claude-toolbox container behind a
# squid egress proxy, via the dind sidecar in docker-compose.yml. Requires AI_PROVIDER=claude-cli.
SANDBOX_ENABLED=false

# Your claude-toolbox image (must contain `claude` + kubectl + aws). No default — set it.
SANDBOX_TOOLBOX_IMAGE=
# Squid proxy image. The stock public image is fine — its config is bind-mounted from
# the checked-in sandbox/squid.conf (allowlist incl. .eks.amazonaws.com + your model endpoint).
SANDBOX_SQUID_IMAGE=ubuntu/squid
# The toolbox image's HOME: Claude's durable state (CLAUDE_CONFIG_DIR=<home>/.claude, for
# --resume across container rebuilds) and the creds tmpfs anchor here. Match your image.
SANDBOX_HOME=/home/sandbox
# Resolver for the proxy — set if egress fails with DNS errors (stock squid often needs it).
SANDBOX_PROXY_DNS=1.1.1.1
# conf.d drop-in dir: squid.conf `include`s /etc/squid/conf.d/*.conf. Drop local ACL
# fragments (e.g. extra allowed_domains) into sandbox/conf.d/ without editing squid.conf.
SANDBOX_SQUID_CONFD=./sandbox/conf.d

# --- optional tuning (defaults shown) ---
# SANDBOX_DOCKER_PATH=docker
# SANDBOX_IDLE_TTL=1800
# SANDBOX_PROVISION_TIMEOUT=60
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_MEMORY_LIMIT=1g
# SANDBOX_PIDS_LIMIT=512

# Model-backend creds for the in-toolbox `claude` live in a SEPARATE file:
#   cp backend/sandbox.env.example backend/sandbox.env   (then fill it)
# compose mounts it at /app/sandbox.env (SANDBOX_ENV_FILE).
