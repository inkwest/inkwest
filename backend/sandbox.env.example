# Model-backend creds for the `claude` running INSIDE each toolbox container
# (provider-agnostic). Copy to backend/sandbox.env (gitignored) and fill:
#   cp backend/sandbox.env.example backend/sandbox.env
# docker-compose mounts it at /app/sandbox.env; the backend passes it to `docker run --env-file`.
# Set ONLY the block for the backend you use.

# --- AWS Bedrock ---
# NOTE: with the LLM auth broker on (LLM_BROKER_ENABLED=true in backend/.env), REMOVE
# AWS_BEARER_TOKEN_BEDROCK from this file — the real key must live ONLY in the backend env, and
# the broker injects a per-turn grant into the sandbox instead. Leaving it here re-introduces the
# exact credential the broker removes. See docs/llm-auth-broker.md §Enable step 3.
CLAUDE_CODE_USE_BEDROCK=1
AWS_BEARER_TOKEN_BEDROCK=replace-with-your-bedrock-bearer-token
AWS_REGION=eu-west-1

# --- or Anthropic API ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- or Google Vertex ---
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=...
# CLOUD_ML_REGION=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/in/toolbox/creds.json
