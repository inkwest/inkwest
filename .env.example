# Inkwest Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# INFERENCE BACKEND
# =============================================================================
# There is no AI_PROVIDER setting. Inference runs through the Claude Code CLI
# (and, when enabled, the sandboxed inkwest-agent); the backend each talks to is
# whatever its own credentials configure — an Anthropic API key, or AWS Bedrock
# (region + bearer/creds). Execution mode is owned by AGENTIC_ENGINES below.
#
# There is NO model env var: the default model is managed in the admin console
# (Model screen) and stored in the database. Unset = the newest model of the
# discovered catalog.

# Anthropic (direct API) backend for the CLI
ANTHROPIC_API_KEY=sk-ant-api03-...

# AWS Bedrock backend — required when the inkwest-agent engine is enabled
# (the LLM auth broker swaps AWS_BEARER_TOKEN_BEDROCK in for the sandbox grant).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_BEARER_TOKEN_BEDROCK=...

# Agentic engines enabled in this deployment (CSV). Default = claude-cli (no AWS
# needed). Add inkwest-agent to run the sandboxed Bedrock Converse loop (all vendors).
# AGENTIC_ENGINES=claude-cli

# Claude CLI knobs (local development - uses your Claude Max subscription)
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT=120
# Optional override of the CLI's model catalog. By default it is auto-discovered
# from the backend the CLI talks to (BACKEND settings: Bedrock or Anthropic API).
# Set this only to pin the list manually; format depends on the CLI's backend
# (bare IDs for Anthropic API, profiles like eu.anthropic.… for Bedrock). Order
# matters: the FIRST entry is the zero-config default model. Selected models are
# passed via `claude --model`.
# CLAUDE_CLI_MODELS=claude-fable-5,claude-opus-4-8,claude-sonnet-4-6

# =============================================================================
# PER-CONVERSATION DOCKER SANDBOX
# =============================================================================
# The sandbox toggle/image/home knobs are read by the BACKEND (they are not
# interpolated by docker-compose here) — see backend/.env.example. The in-toolbox
# model-backend creds go in their own file — see backend/sandbox.env.example.

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://inkwest:inkwest@localhost:5432/inkwest

# Schema the app's tables live in; pinned onto the connection search_path. Default inkwest.
# DB_SCHEMA=inkwest

# For Docker Compose (dev), use:
# DATABASE_URL=postgresql+asyncpg://inkwest:inkwest@db:5432/inkwest

# For Docker Compose (prod), these must be set:
POSTGRES_USER=inkwest
POSTGRES_PASSWORD=inkwest

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-in-production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# KUBERNETES
# =============================================================================
# Directory containing kubeconfig files
KUBECONFIG_DIR=./kubeconfigs

# Default timeout for kubectl commands (seconds)
KUBECTL_TIMEOUT=30

# =============================================================================
# OIDC AUTHENTICATION
# =============================================================================
# Enable OIDC authentication (required for production)
OIDC_ENABLED=false

# OIDC Provider Configuration
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_ISSUER_URL=https://your-keycloak.com/realms/your-realm
# OIDC_CLIENT_ID=inkwest
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# OIDC_SCOPES=openid profile email

# Claim path for extracting roles (varies by provider)
# Keycloak: realm_access.roles
# Auth0: https://your-namespace/roles
# Google: (requires custom claim setup)
# OIDC_ROLES_CLAIM=roles
# OIDC_ADMIN_ROLE=admin

# Login redirect mode: auto = redirect to OIDC provider immediately,
# prompt = show a "Sign in with SSO" page first (avoids redirect loops)
LOGIN_REDIRECT_MODE=prompt

# =============================================================================
# BUDGET MANAGEMENT
# =============================================================================
# Enable budget enforcement
BUDGET_ENABLED=false

# Default limits per user
# DEFAULT_DAILY_TOKEN_LIMIT=100000
# DEFAULT_MONTHLY_TOKEN_LIMIT=2000000

# Global limits (all users combined)
# GLOBAL_DAILY_TOKEN_LIMIT=1000000
# GLOBAL_MONTHLY_TOKEN_LIMIT=20000000

# =============================================================================
# INTERACTIVE FLOW
# =============================================================================
# Confirmation mode: none, tools, expensive, iterations, all
DEFAULT_CONFIRMATION_MODE=expensive

# Cost threshold for confirmation (in cents, so 10 = $0.10)
DEFAULT_COST_THRESHOLD_CENTS=10

# Confirm every N iterations
DEFAULT_ITERATION_INTERVAL=5

# =============================================================================
# WEB SEARCH
# =============================================================================
# Enable web search for documentation
WEB_SEARCH_ENABLED=false

# Search provider: brave, serpapi, google
WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=...

# Max results to return
WEB_SEARCH_MAX_RESULTS=5

# Trusted domains (comma-separated)
WEB_SEARCH_TRUSTED_DOMAINS=kubernetes.io,docs.docker.com,helm.sh,prometheus.io,grafana.com

# Blocked domains (comma-separated)
# WEB_SEARCH_BLOCKED_DOMAINS=

# =============================================================================
# EXTERNAL ACCESS CONNECTORS (AWS / GitLab)
# =============================================================================
CONNECTORS_ENABLED=false

# AWS IAM Identity Center (SSO)
# AWS_SSO_ENABLED=true
# AWS_SSO_START_URL=https://<org>.awsapps.com/start
# AWS_SSO_REGION=eu-west-1
# AWS_SSO_OIDC_CLIENT_ID=...
# AWS_SSO_OIDC_CLIENT_SECRET=...

# Regex (case-insensitive) matched against "<account_name>.<role_name>".
# Empty/unset = all roles shown. Examples:
#   read-?only(-?access)?$   → matches AWSReadOnlyAccess + aws-read-only
#   AWSReadOnlyAccess$       → strict match on that role only
# AWS_SSO_ROLE_FILTER=read-?only(-?access)?$

# GitLab OAuth
# GITLAB_ENABLED=true
# GITLAB_OAUTH_CLIENT_ID=...

# =============================================================================
# MCP (Model Context Protocol) INTEGRATION
# =============================================================================
# Per-conversation MCP servers come from two server-side catalogs. Only the keys (and a
# per-user auth status) ever reach the browser — never the definitions or their secrets.
# Requires sandbox mode (per-conversation .claude.json). See docs/MCP.md.
#
# Static catalog: stdio/static-header servers (Coralogix, kubectl, …). A JSON object
# mapping a stable key to a BASE64-encoded JSON server definition (the value under Claude's
# mcpServers[<key>]). Example (decoded): {"command":"...","args":[...],"env":{...}} or
# {"type":"http","url":"https://...","headers":{"Authorization":"Bearer ..."}}.
# MCP_CATALOG={"coralogix-dev":"<base64(server-def-json)>"}
#
# OAuth2 catalog: remote servers reached via the MCP Authorization spec (OAuth 2.1). Same
# outer shape, but each decoded def is the oauth kind. client_id is optional (omit for
# Dynamic Client Registration). Inkwest brokers the flow per user; tokens are encrypted at
# rest under a browser-fractioned per-user key. Example (decoded value before base64):
#   {"type":"http","url":"https://mcp.example.com/mcp","scopes":["mcp:read"],"client_id":"..."}
# MCP_CATALOG_OAUTH2={"notion":"<base64(oauth-def-json)>"}
#
# Fixed base URL for the OAuth2 MCP callback; MUST match what is registered at the
# authorization server / sent in DCR. Defaults to FRONTEND_URL. The full callback path is
# <MCP_OAUTH_REDIRECT_BASE>/api/mcp/oauth/callback.
# MCP_OAUTH_REDIRECT_BASE=https://inkwest.example.com
#
# Base URL the sandboxed CLI uses to reach the in-app MCP reverse proxy
# (/api/mcp-proxy/{key}/). Unset = oauth MCP servers are never injected into .claude.json
# (the proxy is off). MUST be a host the per-conversation squid allowlists AND can route to
# the backend via the Docker host-gateway — NOT 127.0.0.1 (that is the toolbox itself). See
# docs/MCP.md. Requires single-worker / session affinity (the per-user key lives in RAM).
# MCP_PROXY_BASE_URL=http://inkwest-backend:8000
