# Inkwest Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI PROVIDER
# =============================================================================
# Choose one: anthropic, bedrock, azure, openai, google, openrouter, or claude-cli
AI_PROVIDER=anthropic

# For Anthropic (direct API) - Default
ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514  # or claude-opus-4-20250514

# For Azure OpenAI (GPT models)
# AI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-5-codex
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# For AWS Bedrock (Claude on AWS)
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# For OpenRouter (unified API for multiple AI providers)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4  # or openai/gpt-4o, google/gemini-pro-1.5, etc.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-site.com  # For OpenRouter rankings
# OPENROUTER_APP_NAME=Inkwest

# For OpenAI (direct API)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1  # Override for compatible endpoints

# For Google Gemini
# AI_PROVIDER=google
# GOOGLE_API_KEY=...
# GOOGLE_MODEL=gemini-2.5-flash

# For Claude CLI (local development - uses your Claude Max subscription)
# AI_PROVIDER=claude-cli
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT=120

# =============================================================================
# PER-CONVERSATION DOCKER SANDBOX  (claude-cli provider only)
# =============================================================================
# When enabled, each conversation runs `claude` inside its OWN claude-toolbox
# container, paired with a sibling squid proxy that allowlists egress. Requires
# AI_PROVIDER=claude-cli, the Docker socket mounted into the backend
# (-v /var/run/docker.sock:/var/run/docker.sock), the sessions root mounted at the
# same path (-v /var/lib/inkwest/sessions:/var/lib/inkwest/sessions), and the
# `docker` CLI in the backend image.
# SANDBOX_ENABLED=true

# --- required when enabled ---
# Your images (claude-toolbox = claude+kubectl+aws; squid = forward proxy w/ allowlist):
# SANDBOX_TOOLBOX_IMAGE=registry.example/inkwest-toolbox:latest
# SANDBOX_SQUID_IMAGE=registry.example/inkwest-squid:latest
# Host path to the toolbox .env — the MODEL-BACKEND creds for the in-toolbox claude
# (provider-agnostic: Anthropic API / Bedrock / Vertex / gateway). Mounted into the
# backend; passed to the conversation container via `docker run --env-file`.
# e.g. that file holds CLAUDE_CODE_USE_BEDROCK=1 + AWS_BEARER_TOKEN_BEDROCK=... + AWS_REGION=...
#      or ANTHROPIC_API_KEY=...  or  CLAUDE_CODE_USE_VERTEX=1 + GCP creds.
# SANDBOX_TOOLBOX_ENV_FILE=/etc/inkwest/toolbox.env

# --- optional (defaults shown) ---
# SANDBOX_DOCKER_PATH=docker
# The toolbox image's HOME — Claude's durable state (CLAUDE_CONFIG_DIR=<home>/.claude,
# needed for --resume across container rebuilds) and the creds tmpfs anchor here.
# Must match your image's home dir.
# SANDBOX_HOME=/home/sandbox
# Bind-mount a squid.conf read-only (stock public squid images need this). The conf
# MUST log to a file in the mounted dir: `access_log /var/log/squid/access.log squid`
# (NOT stdio:/dev/stdout — else the durable log + UI tab stay empty). Its allowlist MUST
# include .eks.amazonaws.com (kubectl-against-EKS) and your chosen Claude backend endpoint.
# A ready-to-use reference is checked in at sandbox/squid.conf.
# SANDBOX_SQUID_CONF=/etc/inkwest/squid.conf
# Resolver for the proxy container — set if egress fails with DNS errors (POC used this):
# SANDBOX_PROXY_DNS=1.1.1.1
# SANDBOX_SESSIONS_ROOT=/var/lib/inkwest/sessions
# SANDBOX_IDLE_TTL=1800
# SANDBOX_PROVISION_TIMEOUT=60
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_MEMORY_LIMIT=1g
# SANDBOX_PIDS_LIMIT=512

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://inkwest:inkwest@localhost:5432/inkwest

# For Docker Compose (dev), use:
# DATABASE_URL=postgresql+asyncpg://inkwest:inkwest@db:5432/inkwest

# For Docker Compose (prod), these must be set:
POSTGRES_USER=inkwest
POSTGRES_PASSWORD=inkwest

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-in-production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# KUBERNETES
# =============================================================================
# Directory containing kubeconfig files
KUBECONFIG_DIR=./kubeconfigs

# Default timeout for kubectl commands (seconds)
KUBECTL_TIMEOUT=30

# =============================================================================
# OIDC AUTHENTICATION
# =============================================================================
# Enable OIDC authentication (required for production)
OIDC_ENABLED=false

# OIDC Provider Configuration
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_ISSUER_URL=https://your-keycloak.com/realms/your-realm
# OIDC_CLIENT_ID=inkwest
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# OIDC_SCOPES=openid profile email

# Claim path for extracting roles (varies by provider)
# Keycloak: realm_access.roles
# Auth0: https://your-namespace/roles
# Google: (requires custom claim setup)
# OIDC_ROLES_CLAIM=roles
# OIDC_ADMIN_ROLE=admin

# Login redirect mode: auto = redirect to OIDC provider immediately,
# prompt = show a "Sign in with SSO" page first (avoids redirect loops)
LOGIN_REDIRECT_MODE=prompt

# =============================================================================
# BUDGET MANAGEMENT
# =============================================================================
# Enable budget enforcement
BUDGET_ENABLED=false

# Default limits per user
# DEFAULT_DAILY_TOKEN_LIMIT=100000
# DEFAULT_MONTHLY_TOKEN_LIMIT=2000000

# Global limits (all users combined)
# GLOBAL_DAILY_TOKEN_LIMIT=1000000
# GLOBAL_MONTHLY_TOKEN_LIMIT=20000000

# =============================================================================
# INTERACTIVE FLOW
# =============================================================================
# Confirmation mode: none, tools, expensive, iterations, all
DEFAULT_CONFIRMATION_MODE=expensive

# Cost threshold for confirmation (in cents, so 10 = $0.10)
DEFAULT_COST_THRESHOLD_CENTS=10

# Confirm every N iterations
DEFAULT_ITERATION_INTERVAL=5

# =============================================================================
# WEB SEARCH
# =============================================================================
# Enable web search for documentation
WEB_SEARCH_ENABLED=false

# Search provider: brave, serpapi, google
WEB_SEARCH_PROVIDER=brave
# WEB_SEARCH_API_KEY=...

# Max results to return
WEB_SEARCH_MAX_RESULTS=5

# Trusted domains (comma-separated)
WEB_SEARCH_TRUSTED_DOMAINS=kubernetes.io,docs.docker.com,helm.sh,prometheus.io,grafana.com

# Blocked domains (comma-separated)
# WEB_SEARCH_BLOCKED_DOMAINS=

# =============================================================================
# MCP (Model Context Protocol) INTEGRATION
# =============================================================================
# Configure MCP servers for extended context (JSON array)
# Example:
# MCP_SERVERS=[{"name":"aws","type":"aws","endpoint":"http://localhost:3000","api_key":"..."},{"name":"gitlab","type":"gitlab","endpoint":"http://localhost:3001","api_key":"glpat-..."}]

# Individual MCP server shortcuts (alternative to JSON config)
# AWS_MCP_ENDPOINT=http://localhost:3000
# GITLAB_MCP_ENDPOINT=http://localhost:3001
# GITLAB_MCP_TOKEN=glpat-...
# GITHUB_MCP_ENDPOINT=http://localhost:3002
# GITHUB_MCP_TOKEN=ghp_...
# PROMETHEUS_MCP_ENDPOINT=http://localhost:3003
# DATADOG_MCP_ENDPOINT=http://localhost:3004
# DATADOG_MCP_API_KEY=...
